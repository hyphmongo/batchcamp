{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
  },
  "overrides": [
    {
      "includes": ["src/**/*.ts", "src/**/*.tsx", "!src/shared/zod.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import z from @/shared/zod so the JIT stays disabled under extension CSP."
                }
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error",
        "noControlCharactersInRegex": "off",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        },
        "noImportCycles": "error",
        "noReactForwardRef": "error",
        "noSkippedTests": "error"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useBlockStatements": "error",
        "useConsistentArrowReturn": "error",
        "useImportType": "error",
        "useExportType": "error",
        "noUselessElse": "error"
      },
      "complexity": {
        "noUselessUndefined": "error",
        "noUselessFragments": "error",
        "noStaticOnlyClass": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 30
          }
        }
      },
      "a11y": {
        "noLabelWithoutControl": "off",
        "useButtonType": "error",
        "noStaticElementInteractions": "off",
        "useAriaPropsSupportedByRole": "off",
        "useSemanticElements": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "error",
        "noConstantMathMinMaxClamp": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  }
}
