{
  "name": "batchcamp",
  "private": true,
  "version": "2.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.1 || >=24.11.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build-firefox": "tsc && TARGET=firefox vite build",
    "build-chrome": "tsc && TARGET=chrome vite build",
    "preview": "vite preview",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "lint:ext": "pnpm build-firefox && pnpm dlx web-ext lint --source-dir=dist",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dead-code": "knip",
    "mutation": "stryker run",
    "mutation:hooks": "stryker run stryker.hooks.json",
    "check": "tsc --noEmit && biome check . && vitest run && knip",
    "prepare": "husky && effect-tsgo patch --typescript --no-oxlint"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/browser": "^10.70.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@wxt-dev/storage": "^1.2.9",
    "class-variance-authority": "^0.7.1",
    "detect-browser": "^5.3.0",
    "effect": "^3.22.1",
    "immer": "^11.1.16",
    "p-queue": "^9.3.3",
    "posthog-js": "^1.415.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@biomejs/biome": "^2.5.8",
    "@effect/tsgo": "0.36.4",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sentry/vite-plugin": "^5.4.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/chrome": "^0.2.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "knip": "^6.32.1",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^4.1.10",
    "vitest-chrome": "^0.1.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{ts,tsx}": [
      "vitest related --run --passWithNoTests"
    ]
  },
  "packageManager": "pnpm@9.7.0+sha512.dc09430156b427f5ecfc79888899e1c39d2d690f004be70e05230b72cb173d96839587545d09429b55ac3c429c801b4dc3c0e002f653830a420fa2dd4e3cf9cf",
  "pnpm": {
    "overrides": {
      "shell-quote@<1.8.4": ">=1.8.4",
      "esbuild@<0.28.1": ">=0.28.1",
      "tmp@<0.2.6": ">=0.2.6",
      "qs@<6.15.2": ">=6.15.2",
      "uuid@<11.1.1": ">=11.1.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "use-sync-external-store>react": "19"
      }
    }
  }
}
